{
  "name": "@cccv/cli",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "bin": {
    "cccv": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "bun run src/index.ts .",
    "build": "bun build src/index.ts --compile --outfile dist/cccv && rm -rf dist/ui && cp -R ../ui/dist dist/ui"
  },
  "dependencies": {
    "@cccv/shared": "workspace:*",
    "@cccv/server": "workspace:*",
    "@cccv/capture": "workspace:*",
    "open": "^10.1.0"
  }
}
